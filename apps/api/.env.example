APP_ENV=development
APP_PORT=8080
FRONTEND_ORIGINS=http://localhost:3000
DATABASE_URL=bem_dev:local_only_change_me@tcp(127.0.0.1:3306)/bem_fmikom_dev?parseTime=true
JWT_SECRET=LOCAL_ONLY_GENERATE_A_RANDOM_32_BYTE_SECRET
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_BCRYPT_COST=12
AUTH_REFRESH_COOKIE_NAME=bem_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW=1m
AUTH_REFRESH_RATE_LIMIT=30
AUTH_REFRESH_RATE_WINDOW=1m
PUBLIC_ASPIRATION_RATE_LIMIT=5
PUBLIC_ASPIRATION_RATE_WINDOW=15m
PUBLIC_REGISTRATION_RATE_LIMIT=5
PUBLIC_REGISTRATION_RATE_WINDOW=30m
DOCUMENT_STORAGE_PATH=../../var/private/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
MEDIA_STORAGE_PATH=../../var/media
MEDIA_MAX_UPLOAD_BYTES=5242880
REGISTRATION_STORAGE_PATH=../../var/private/registration-attachments
REGISTRATION_IMAGE_MAX_UPLOAD_BYTES=5242880
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=1m
