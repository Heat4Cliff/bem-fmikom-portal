APP_ENV=development
APP_PORT=8080
FRONTEND_ORIGINS=http://localhost:3000
DB_NAME=bem_fmikom_dev
DB_USER=bem_dev
DB_PASSWORD=local_only_change_me
DB_ROOT_PASSWORD=local_only_root_change_me
DATABASE_URL=bem_dev:local_only_change_me@tcp(127.0.0.1:3306)/bem_fmikom_dev?parseTime=true
TEST_DATABASE_URL=root:local_only_root_change_me@tcp(127.0.0.1:3306)/bem_fmikom_test?parseTime=true
JWT_SECRET=LOCAL_ONLY_GENERATE_A_RANDOM_32_BYTE_SECRET
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=168h
AUTH_BCRYPT_COST=12
AUTH_REFRESH_COOKIE_NAME=bem_refresh
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_LOGIN_RATE_LIMIT=5
AUTH_LOGIN_RATE_WINDOW=1m
DOCUMENT_STORAGE_PATH=../../var/private/documents
DOCUMENT_MAX_UPLOAD_BYTES=10485760
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
